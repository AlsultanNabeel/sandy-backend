# One answer to "spaces or tabs" per language, applied by the editor rather than
# by review comments.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{swift,kt,kts}]
indent_size = 4

[*.{c,h,ino,cpp}]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown — stripping them changes the
# rendered text.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
