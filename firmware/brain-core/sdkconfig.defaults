# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash — N16R8: 16MB QIO 80MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM — N16R8: 8MB OPI (octal)
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Disable Bluetooth — saves ~100KB RAM
CONFIG_BT_ENABLED=n

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Task Watchdog: the voice, mic, front-end, speaker, uplink, display and broker tasks
# feed it (sandy_health.h); a hung one restarts the board. 10 s: one uplink write may
# take 4 s on a bad link. Needs a fresh sdkconfig.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# MQTT buffer
CONFIG_MQTT_BUFFER_SIZE=1024
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=30000

# TLS cert bundle — lets the /voice WSS client verify Heroku's cert
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Clock: the router first, then three public servers (sandy_voice.c, clock_start).
CONFIG_LWIP_SNTP_MAX_SERVERS=4

# OTA pull over HTTPS only (the LAN push server is separate).
CONFIG_OTA_ALLOW_HTTP=n

# Rollback: a new image boots PENDING_VERIFY; sandy_ota.c confirms it once it
# is still rescuable (Wi-Fi + update server), else the bootloader reverts.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ADC
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# Stack smashing caught by the compiler (canaries on functions with arrays), on top of
# FreeRTOS's end-of-stack canary. Needs a fresh sdkconfig.
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# LVGL — SPI panels need byte-swapped RGB565 (else blue renders as green)
CONFIG_LV_COLOR_16_SWAP=y

# Pack only the "Hi Andy" wake word (closest built-in to "Sandy"); NSN/VAD use WebRTC.
CONFIG_SR_WN_WN9_HIANDY_TTS2=y

# MultiNet English command words (~2.1MB, table in sandy_voice.c); needs the 4MB model partition.
CONFIG_SR_MN_EN_MULTINET5_SINGLE_RECOGNITION_QUANT8=y

# TLS buffers in PSRAM: MQTT + voice TLS together exhausted the internal heap.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# WiFi/lwip buffers in PSRAM too, to keep internal headroom for TLS.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Allocations above 1024 bytes go to PSRAM (4096 left esp-aes without internal RAM).
# DMA-tagged allocations still stay internal.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=3
CONFIG_LV_FONT_DEJAVU_16_PERSIAN_HEBREW=y
CONFIG_LV_USE_BIDI=y
CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y

# ── WebSocket client: one lock per direction ──
# قفل واحد للإرسال والاستقبال كان يأخّر المايك تلات ثواني وهي بتحكي
# ("Could not lock ws-client within 400 timeout"). قفل إرسال مستقل بيحلّها.
# امسح `sdkconfig` مرة وحدة عشان الخيار ياخد مفعوله.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000

# ── Internal RAM for the voice call ──
# بيرجّعوا ~٥٠ كيلو داخلية لمصافحة الصوت:
# ١. ذاكرة LVGL من المخصّص العام بدل مصفوفة ثابتة ٣٢ كيلو.
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
# ٢. دوال استقبال الوايفاي برّا الذاكرة الداخلية (١٧ كيلو).
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# ٣. عشر مخازن إرسال ثابتة بتكفّي الصوت الطالع.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10

# ── Crash dumps to flash ──
# Dump goes to the `coredump` partition; read with `idf.py coredump-info`. Needs a fresh sdkconfig.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# ── QR code on her face at setup ──
CONFIG_LV_USE_QRCODE=y

# The audio front end (two mics, echo cancelling, separation, wake word) needs the full
# 240 MHz: at 160 the mic task fell behind and lost ~14% of the mic samples.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
