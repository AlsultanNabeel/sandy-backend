<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sandy</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.674790516773-ahf3kvtl8emvdid9b7brjfq7d63t8cqe</string>
			</array>
		</dict>
		<dict>
			<!-- sandy:// deep links (App/DeepLinkRouter.swift). -->
			<key>CFBundleURLName</key>
			<string>com.sandy.app.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sandy</string>
			</array>
		</dict>
	</array>
	<!-- The live voice call shows on the Lock Screen and in the Dynamic Island. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<!-- Dark (#020508) to avoid a white flash; LaunchHandoff in App/SandyApp.swift takes over the mark. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain http only on the local network (camera LAN stream); internet stays HTTPS-only. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- A live voice call keeps going with the screen locked. -->
		<string>audio</string>
	</array>
</dict>
</plist>
