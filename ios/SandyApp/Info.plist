<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sandy</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.674790516773-ahf3kvtl8emvdid9b7brjfq7d63t8cqe</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleIdentifier</key>
			<string></string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<!-- Theme.Colors.background (#020508): the system launch screen was white,
		     a quarter-second flash before the app's dark first frame. Sandy sits in
		     the middle; LaunchHandoff (App/SandyApp.swift) takes over the same image
		     at the same spot and animates it out. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain http only on the local network (the robot camera's LAN stream,
		     a dev server on *.local). Every internet host stays HTTPS-only. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- A live voice call keeps going with the screen locked. -->
		<string>audio</string>
	</array>
</dict>
</plist>
