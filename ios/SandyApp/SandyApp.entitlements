<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sandy.app</string>
	</array>
	<!-- Sign in with Apple (com.apple.developer.applesignin) and push (aps-environment)
	     are left out on purpose while the app is signed with a free personal team: a
	     personal team can't issue a profile carrying either one, so the build fails.
	     Until they're back, Apple sign-in fails on device with ASAuthorizationError 1000
	     and registerForRemoteNotifications produces no token. Put both back (see commit
	     1f0da04) as soon as the paid developer account is active. -->
</dict>
</plist>
